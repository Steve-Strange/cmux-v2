 namespace {

+std::string CmuxCssColor(cmux::CmuxArgb color) {
+  return base::StringPrintf("#%02x%02x%02x", cmux::CmuxArgbR(color),
+                            cmux::CmuxArgbG(color), cmux::CmuxArgbB(color));
+}
+
 void OpenWebPage(Profile* profile, const GURL& url) {
   NavigateParams navigate_params(profile, url, ui::PAGE_TRANSITION_LINK);
   navigate_params.window_action = NavigateParams::WindowAction::kShowWindow;
@@ -398,6 +406,47 @@ void CustomizeChromePageHandler::UpdateThemeEditable(bool is_theme_editable) {
   page_->SetThemeEditable(is_theme_editable);
 }

+void CustomizeChromePageHandler::GetCmuxThemePickerState(
+    GetCmuxThemePickerStateCallback callback) {
+  cmux::LoadCmuxThemePickerState(base::BindOnce(
+      &CustomizeChromePageHandler::OnCmuxThemePickerStateLoaded,
+      weak_ptr_factory_.GetWeakPtr(), std::move(callback)));
+}
+
+void CustomizeChromePageHandler::OnCmuxThemePickerStateLoaded(
+    GetCmuxThemePickerStateCallback callback,
+    std::vector<cmux::GhosttyThemePreview> themes,
+    std::string selected_theme) {
+  cmux_ghostty_themes_.clear();
+  std::vector<side_panel::mojom::CmuxGhosttyThemePreviewPtr> theme_previews;
+  theme_previews.reserve(themes.size());
+  for (const cmux::GhosttyThemePreview& theme : themes) {
+    cmux_ghostty_themes_.insert(theme.name);
+    auto preview = side_panel::mojom::CmuxGhosttyThemePreview::New();
+    preview->name = theme.name;
+    preview->background = CmuxCssColor(theme.background);
+    preview->foreground = CmuxCssColor(theme.foreground);
+    preview->cursor = CmuxCssColor(theme.cursor);
+    preview->palette.reserve(theme.palette.size());
+    for (cmux::CmuxArgb color : theme.palette) {
+      preview->palette.push_back(CmuxCssColor(color));
+    }
+    theme_previews.push_back(std::move(preview));
+  }
+  auto state = side_panel::mojom::CmuxThemePickerState::New();
+  state->themes = std::move(theme_previews);
+  state->selected_theme = std::move(selected_theme);
+  std::move(callback).Run(std::move(state));
+}
+
+void CustomizeChromePageHandler::SetCmuxGhosttyTheme(
+    const std::string& theme,
+    SetCmuxGhosttyThemeCallback callback) {
+  const bool valid =
+      theme.empty() || cmux_ghostty_themes_.contains(theme);
+  std::move(callback).Run(valid && cmux::ApplyCmuxGhosttyTheme(theme));
+}
+
 void CustomizeChromePageHandler::OpenChromeWebStore() {
   open_url_callback_.Run(
       GURL("https://chromewebstore.google.com/category/themes"));
@@ -547,7 +596,11 @@ void CustomizeChromePageHandler::OnBrowserWindowInterfaceChanged() {
