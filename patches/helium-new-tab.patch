+
+.ghostty-theme-option:hover {
+  background-color: var(--cr-hover-background-color);
+}
+
+.ghostty-theme-option:focus-within {
+  background-color: var(--cr-menu-background-focus-color);
+  outline: none;
+}
+
+.ghostty-theme-option:has(.ghostty-theme-radio:checked) {
+  background-color: var(--color-sys-tonal-container);
+}
+
+.ghostty-theme-radio {
+  height: 1px;
+  opacity: 0;
+  position: absolute;
+  width: 1px;
+}
+
+.ghostty-theme-option-copy {
+  display: flex;
+  flex: 1 1 auto;
+  flex-direction: column;
+  gap: 3px;
+  min-width: 0;
+}
+
+.ghostty-theme-name {
+  font-size: 12px;
+  font-weight: 500;
+  line-height: 18px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.ghostty-theme-description {
+  color: var(--cr-secondary-text-color);
+  font-size: 10px;
+  font-weight: 400;
+  line-height: 14px;
+  white-space: normal;
+}
+
+.ghostty-theme-preview {
+  --ghostty-preview-background: #1e1e1e;
+  --ghostty-preview-cursor: #f5f5f5;
+  --ghostty-preview-foreground: #f5f5f5;
+  background: var(--ghostty-preview-background);
+  border: 1px solid
+      color-mix(in srgb, var(--ghostty-preview-foreground) 24%, transparent);
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgb(0 0 0 / 18%);
+  box-sizing: border-box;
+  display: block;
+  flex: 0 0 64px;
+  height: 48px;
+  overflow: hidden;
+  position: relative;
+  width: 64px;
+}
+
+.ghostty-theme-preview-bar {
+  align-items: center;
+  background:
+      color-mix(in srgb, var(--ghostty-preview-foreground) 10%, transparent);
+  display: flex;
+  gap: 3px;
+  height: 12px;
+  padding-inline-start: 6px;
+}
+
+.ghostty-theme-preview-bar i {
+  background:
+      color-mix(in srgb, var(--ghostty-preview-foreground) 55%, transparent);
+  border-radius: 50%;
+  height: 3px;
+  width: 3px;
+}
+
+.ghostty-theme-preview-command {
+  align-items: center;
+  display: flex;
+  gap: 3px;
+  height: 27px;
+  padding: 0 6px 3px;
+}
+
+.ghostty-theme-preview-command b {
+  color: var(--ghostty-preview-cursor);
+  font-size: 10px;
+  font-weight: 700;
+  line-height: 10px;
+}
+
+.ghostty-theme-preview-command i,
+.ghostty-theme-preview-command em {
+  background: var(--ghostty-preview-foreground);
+  border-radius: 1px;
+  height: 3px;
+  opacity: 0.8;
+  width: 17px;
+}
+
+.ghostty-theme-preview-command em {
+  opacity: 0.4;
+  width: 10px;
+}
+
+.ghostty-theme-preview-swatches {
+  bottom: 0;
+  display: grid;
+  grid-template-columns: repeat(8, 1fr);
+  height: 8px;
+  inset-inline: 0;
+  position: absolute;
+}
+
+.ghostty-theme-preview-swatches i {
+  background: var(--ghostty-preview-swatch);
+}
+
+.ghostty-theme-preview-auto {
+  --ghostty-preview-background: var(--color-sys-surface);
+  --ghostty-preview-cursor: var(--color-sys-primary);
+  --ghostty-preview-foreground: var(--cr-primary-text-color);
+}
+
+.ghostty-theme-preview-auto .ghostty-theme-preview-swatches i:nth-child(1) {
+  --ghostty-preview-swatch: var(--color-sys-surface);
+}
+
+.ghostty-theme-preview-auto .ghostty-theme-preview-swatches i:nth-child(2) {
+  --ghostty-preview-swatch: var(--color-sys-error);
+}
+
+.ghostty-theme-preview-auto .ghostty-theme-preview-swatches i:nth-child(3) {
+  --ghostty-preview-swatch: #34a853;
+}
+
+.ghostty-theme-preview-auto .ghostty-theme-preview-swatches i:nth-child(4) {
+  --ghostty-preview-swatch: #fbbc04;
+}
+
+.ghostty-theme-preview-auto .ghostty-theme-preview-swatches i:nth-child(5),
+.ghostty-theme-preview-auto .ghostty-theme-preview-swatches i:nth-child(7) {
+  --ghostty-preview-swatch: var(--color-sys-primary);
+}
+
+.ghostty-theme-preview-auto .ghostty-theme-preview-swatches i:nth-child(6) {
+  --ghostty-preview-swatch: #a142f4;
+}
+
+.ghostty-theme-preview-auto .ghostty-theme-preview-swatches i:nth-child(8) {
+  --ghostty-preview-swatch: var(--cr-primary-text-color);
+}
+
+.ghostty-theme-check {
+  --cr-icon-color: var(--color-sys-primary);
+  --cr-icon-size: 20px;
+  flex: 0 0 20px;
+}
+
+.ghostty-theme-check[hidden] {
+  visibility: hidden;
+}
+
+.ghostty-theme-message {
+  color: var(--cr-secondary-text-color);
+  font-weight: 400;
+  padding: 24px 16px;
+  text-align: center;
+}
+
+.ghostty-theme-error {
+  color: var(--color-sys-error);
+  padding: 8px 16px 12px;
+  text-align: start;
+}
+
+#ghosttyThemeList .sp-hr {
+  margin: 8px 16px;
+}
