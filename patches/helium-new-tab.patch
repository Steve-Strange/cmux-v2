+  protected async onCmuxAppearanceButtonClick_() {
+    this.page_ = CustomizeChromePage.GHOSTTY_THEMES;
+    this.ghosttyThemeQuery_ = '';
+    void this.loadCmuxGhosttyThemes_();
+    await this.updateComplete;
+    this.$.ghosttyThemesHeading.getBackButton().focus();
+  }
+
+  protected onGhosttyThemeSearchChanged_(event: CustomEvent<string>) {
+    this.ghosttyThemeQuery_ = event.detail;
+  }
+
+  protected onGhosttyThemesBackButtonClick_() {
+    void this.onBackClick_();
+  }
+
+  protected getGhosttyThemeSelectHandler_(theme: string) {
+    return () => {
+      void this.onGhosttyThemeSelect_(theme);
+    };
+  }
+
+  protected getFilteredGhosttyThemes_(): CmuxGhosttyThemePreview[] {
+    const query = this.ghosttyThemeQuery_.trim().toLowerCase();
+    if (!query) {
+      return this.ghosttyThemes_;
+    }
+    return this.ghosttyThemes_.filter(
+        theme => theme.name.toLowerCase().includes(query));
+  }
+
+  protected getGhosttyThemePreviewStyle_(
+      theme: CmuxGhosttyThemePreview): string {
+    return [
+      `--ghostty-preview-background: ${theme.background}`,
+      `--ghostty-preview-foreground: ${theme.foreground}`,
+      `--ghostty-preview-cursor: ${theme.cursor}`,
+    ].join(';');
+  }
+
+  protected async onGhosttyThemeSelect_(theme: string) {
+    if (theme === this.selectedGhosttyTheme_) {
+      return;
+    }
+
+    const previousTheme = this.selectedGhosttyTheme_;
+    const generation = ++this.ghosttyThemeSaveGeneration_;
+    this.selectedGhosttyTheme_ = theme;
+    this.ghosttyThemeError_ = '';
+    try {
+      const {success} =
+          await this.apiProxy_.handler.setCmuxGhosttyTheme(theme);
+      if (generation !== this.ghosttyThemeSaveGeneration_) {
+        return;
+      }
+      if (!success) {
+        this.selectedGhosttyTheme_ = previousTheme;
+        this.ghosttyThemeError_ = 'Could not apply that Ghostty theme.';
+      }
+    } catch {
+      if (generation === this.ghosttyThemeSaveGeneration_) {
+        this.selectedGhosttyTheme_ = previousTheme;
+        this.ghosttyThemeError_ = 'Could not apply that Ghostty theme.';
+      }
+    }
+  }
+
+  private async loadCmuxGhosttyThemes_() {
+    this.ghosttyThemesLoading_ = true;
+    this.ghosttyThemeError_ = '';
+    try {
+      const {state} =
+          await this.apiProxy_.handler.getCmuxThemePickerState();
+      this.ghosttyThemes_ = state.themes;
+      this.selectedGhosttyTheme_ = state.selectedTheme;
+    } catch {
+      this.ghosttyThemeError_ =
+          'Could not load the bundled Ghostty themes.';
+    } finally {
+      this.ghosttyThemesLoading_ = false;
+    }
+  }
